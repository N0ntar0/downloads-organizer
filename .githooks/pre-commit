#!/bin/sh

# 衝突マーカーの検査は ALLOW_PROTECTED_COMMIT=1 でも回避させない
if git rev-parse --verify --quiet HEAD >/dev/null; then
  against=HEAD
else
  against=$(git hash-object -t tree /dev/null)
fi
markers=$(git diff --cached --check "$against" -- | grep 'leftover conflict marker')
if [ -n "$markers" ]; then
  printf '%s\n' \
    "エラー: ステージした内容に衝突マーカーが残っています。" \
    "$markers" \
    "マーカーを消してから、もう一度コミットしてください。" >&2
  exit 1
fi

if [ "${ALLOW_PROTECTED_COMMIT:-}" = "1" ]; then
  exit 0
fi

branch=$(git symbolic-ref --quiet --short HEAD) || exit 0

case "$branch" in
  main)
    printf '%s\n' \
      "エラー: $branch ブランチへの直接コミットは許可されていません。" \
      "docs/git-workflow.md のブランチ構成に従い、Issueに対応する作業ブランチへ切り替えてください。" \
      "緊急時に限り ALLOW_PROTECTED_COMMIT=1 を設定すると、この確認を回避できます。" >&2
    exit 1
    ;;
esac

exit 0
